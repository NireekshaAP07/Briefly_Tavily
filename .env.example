# Server configuration
PORT=3000

# Tavily API (Primary Web Search Provider)
# Obtain your key from https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Bifrost Gateway Configuration (Model Gateway)
# Bifrost acts as the model gateway / proxy routing AI requests
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=your-bifrost-key-or-leave-blank
LLM_MODEL=openai/gpt-4o-mini
